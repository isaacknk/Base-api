app.get('/api/nerding', async (req, res, next) => {
    try {
        const apikey = req.query.apikey;
        const q = req.query.q;

        if (!apikey) return res.json({ resultado: 'Cade o parametro apikey?' });
        if (!q) return res.json({ status: false, criador: 'SANDRO BOT', mensagem: "Coloque o parametro: q" });

        if (!key || !Array.isArray(key)) return res.json({ erro: 'Erro no servidor: banco de keys não carregado' });

        const keyIndex = key.findIndex(i => i?.apikey === apikey);
        if (keyIndex === -1) return res.sendFile(path.join(__dirname, "./public/", "limited.html"));

        if (key[keyIndex]?.request <= 0) return res.sendFile(path.join(__dirname, "./public/", "limited.html"));

        await listkeys(apikey, req);

        nerding(q)
            .then(resultado => {
                res.json({
                    status: true,
                    código: 200,
                    criador: 'SANDRO BOT',
                    resultado: resultado
                });
            })
            .catch(e => {
                console.error("Erro no nerding:", e);
                res.json({ msg: "Erro no Servidor Interno" });
            });

    } catch (error) {
        console.error("Erro interno:", error);
        res.json({ msg: "Erro no Servidor Interno" });
    }
});

